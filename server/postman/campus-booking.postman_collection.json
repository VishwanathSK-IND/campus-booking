{
  "info": {
    "name": "Campus Booking API",
    "description": "Local API for the campus resource booking app.\n\n**How to use**\n1. Start MongoDB and the backend (`cd server && npm run dev`), seed demo data once with `npm run seed`.\n2. Run **Health** to confirm the API is up.\n3. Run a **Login** request. Auth is a cookie, so Postman keeps you logged in automatically — no token to copy.\n4. Requests that create things save their IDs into collection variables (resourceId, bookingId, …) so the next requests just work.\n\nDemo password for all seeded accounts: `Campus@123` (variable `password`).\n`bookingDate` is set automatically to tomorrow (campus time) before each request unless you set it yourself.\nTo switch user, run **Logout** then another **Login**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default bookingDate = tomorrow in campus time (Asia/Kolkata), unless set manually.",
          "if (!pm.collectionVariables.get('bookingDateManual')) {",
          "  const now = new Date(Date.now() + 5.5 * 60 * 60 * 1000 + 24 * 60 * 60 * 1000);",
          "  pm.collectionVariables.set('bookingDate', now.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "password",
      "value": "Campus@123"
    },
    {
      "key": "bookingDate",
      "value": ""
    },
    {
      "key": "bookingDateManual",
      "value": "",
      "description": "Set to any value to stop bookingDate being overwritten automatically."
    },
    {
      "key": "resourceId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "waitlistId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "blockId",
      "value": ""
    },
    {
      "key": "restrictionId",
      "value": ""
    }
  ],
