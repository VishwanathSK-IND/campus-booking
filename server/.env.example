NODE_ENV=development
PORT=5000

# Local MongoDB or MongoDB Atlas connection string.
# Atlas (a replica set) enables multi-document transactions automatically.
MONGO_URI=mongodb://127.0.0.1:27017/campus_booking

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
QR_TOKEN_SECRET=replace-with-a-different-long-random-secret
# Lifetime of each rotating venue check-in QR token, in seconds.
QR_TOKEN_TTL_SECONDS=90

# Comma-separated list of allowed frontend origins (CORS + check-in QR links).
CLIENT_URL=http://localhost:5173

# Campus timezone used for operating hours, booking times and analytics.
APP_TIMEZONE=Asia/Kolkata

# Cookies: production defaults are Secure + SameSite=None (frontend and API on different domains).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# Set when running behind a reverse proxy (Render, Railway, Nginx).
# TRUST_PROXY=true

# Background jobs (no-shows, reminders, waitlist offers). Cron expression for the job tick.
JOBS_ENABLED=true
JOBS_CRON=* * * * *

RATE_LIMIT_ENABLED=true
